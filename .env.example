# Copy to .env for local development. Flags are OFF / empty unless explicitly set.
#
# Renders the ad markup inside the reserved slots. The slots reserve their height
# either way, so turning this on must never move anything on the page.
PUBLIC_ADS_ENABLED=false

# ── Google AdSense (2026-08-31) ─────────────────────────────────────────────
# NEVER put a real publisher ID in this .example file or in git. Set the real
# value only in your local .env (gitignored) and in the Cloudflare Pages
# project's own Environment Variables settings for production. Leaving this
# empty means no AdSense script renders anywhere, no matter what
# PUBLIC_ADS_ENABLED says — see src/components/Head.astro.
#
# Get it from: AdSense dashboard -> Account -> Account information ->
# Publisher ID (the "pub-XXXXXXXXXXXXXXXX" number, no "ca-" prefix needed here
# — components add that themselves where the official script format requires it).
PUBLIC_ADSENSE_PUBLISHER_ID=

# auto | manual | both. See README's "Ads" section. AUTO relies entirely on
# the global script + Google's own on-page scanning (enabled from the AdSense
# dashboard, Ads -> Auto ads) and renders NO manual <AdSlot> markup — the
# reserved-space placeholders still show in dev so the layout is visible, but
# nothing is pushed to adsbygoogle. MANUAL renders a real <ins> unit in each
# <AdSlot> that has a configured per-slot ID (see the PUBLIC_ADSENSE_SLOT_*
# vars below) and none where it doesn't. BOTH does both — not recommended by
# Google, offered because the spec asked for it. Defaults to auto once ads
# are actually enabled; stays inert while PUBLIC_ADS_ENABLED is false.
PUBLIC_ADSENSE_MODE=auto

# Per-unit ad slot IDs from the AdSense dashboard (Ads -> By ad unit -> create
# unit), needed ONLY for MANUAL/BOTH mode. These do not exist until the site
# is approved and units are created there — leave empty until you have real
# ones. An AdSlot with no matching ID here always falls back to the inert
# reserved-space placeholder, it never fakes a slot id.
PUBLIC_ADSENSE_SLOT_ARTICLE_TOP=
PUBLIC_ADSENSE_SLOT_ARTICLE_MID=
PUBLIC_ADSENSE_SLOT_SIDEBAR=

# Includes draft: true posts in the site. Development only.
# MUST stay unset in Vercel production, or unpublished drafts go live.
PUBLIC_SHOW_DRAFTS=false
