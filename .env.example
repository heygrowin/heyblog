# Copy to .env for local development. Both flags are OFF unless explicitly set to "true".
#
# Renders the ad markup inside the reserved slots. The slots reserve their height
# either way, so turning this on must never move anything on the page.
PUBLIC_ADS_ENABLED=false

# Includes draft: true posts in the site. Development only.
# MUST stay unset in Vercel production, or unpublished drafts go live.
PUBLIC_SHOW_DRAFTS=false
